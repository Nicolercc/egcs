---
import { Image } from 'astro:assets';
import Logo2 from '../assets/logo2.png';
import { getLangFromUrl } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;
const pathEn = pathname.startsWith("/es") ? (pathname.slice(3) || "/") : pathname;
const pathEs = pathname.startsWith("/es") ? pathname : pathname === "/" ? "/es" : "/es" + pathname;

const homeHref = lang === "es" ? "/es" : "/";
const servicesHref = lang === "es" ? "/es/services" : "/services";
const aboutHref = lang === "es" ? "/es/about" : "/about";
const quoteHref = lang === "es" ? "/es/quote" : "/quote";
---

<nav class="fixed top-0 left-0 right-0 shadow-md z-50 bg-white/70 backdrop-blur-md overflow-visible">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-between items-center py-2">
              <div class="flex items-center relative h-12 overflow-visible">
          <a href={homeHref} class="font-semibold text-xl text-gray-800 flex items-center  z-10">
            <Image 
              src={Logo2} 
              alt="Elite Global Cleaning Services Logo" 
              class="h-52 w-auto object-contain" 
             
            />
          </a>
        </div>

      <!-- Desktop menu -->
      <div class="hidden md:flex items-center space-x-6 absolute left-1/2 transform -translate-x-1/2">
        <a href={homeHref} class="text-gray-700 hover:text-yellow-600">Home</a>
        <a href={servicesHref} class="text-gray-700 hover:text-yellow-600">Services</a>
        <!-- <a href="/contact" class="text-gray-600 hover:text-yellow-600">Contact</a> -->
        <a href={aboutHref} class="text-gray-700 hover:text-yellow-600">About</a>
      </div>

      <!-- Desktop CTA and Translator -->
      <div class="hidden md:flex items-center space-x-4">
        <div class="flex items-center text-sm font-medium">
          <a href={pathEn} class={lang === "en" ? "text-yellow-600 font-bold" : "text-gray-500 hover:text-yellow-600"}>EN</a>
          <span class="mx-1 text-gray-300">|</span>
          <a href={pathEs} class={lang === "es" ? "text-yellow-600 font-bold" : "text-gray-500 hover:text-yellow-600"}>ES</a>
        </div>
        <a href={quoteHref} class="text-white px-4 py-2 rounded-full bg-yellow-500 hover:bg-yellow-600 transition duration-300">
          Quote
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button 
          id="mobile-menu-button" 
          class="text-gray-500 hover:text-yellow-600 focus:outline-none"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden bg-transparent ">
      <div class="py-6">
        <!-- Top Row - Menu and Logo -->
        <div class="  mb-2">
          <!-- Left Column - Page Menu -->
          <div class="flex flex-col space-y-2 justify-center">
            <a href={homeHref} class="text-gray-700 text-center  hover:text-yellow-600">Home</a>
            <a href={servicesHref} class="text-gray-700 text-center  hover:text-yellow-600">Services</a>
            <a href={aboutHref} class="text-gray-700 text-center  hover:text-yellow-600">About</a>
          </div>
          
          <!-- Right Column - Logo -->
          <!--  -->
        </div>
        
        <div class="flex items-center justify-center text-sm font-medium mb-4">
          <a href={pathEn} class={lang === "en" ? "text-yellow-600 font-bold" : "text-gray-500 hover:text-yellow-600"}>EN</a>
          <span class="mx-1 text-gray-300">|</span>
          <a href={pathEs} class={lang === "es" ? "text-yellow-600 font-bold" : "text-gray-500 hover:text-yellow-600"}>ES</a>
        </div>
 
        <div class="flex justify-center">
          <a href={quoteHref} class="text-white px-8 py-2 text-center rounded-xl transition bg-yellow-500 hover:bg-yellow-600 duration-300 shadow-lg text-lg">Get a Quote</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
