---
import CleaningImg from '../assets/cleaning.jpg'
import AsbestosImg from '../assets/Asbestos-abatement.jpg'
import MoldImg from '../assets/mold.jpg'
import LeadImg from '../assets/lead-paint-removal.jpg'
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, type Lang } from "../i18n/translations";

const { lang: propLang }: { lang?: Lang } = Astro.props;
const lang = propLang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'es' ? '/es/services' : '/services';
---

<section class=" md:pt-14 lg:pt-16 px-4 sm:px-6 lg:px-8 ">
  <div class="max-w-7xl mx-auto">
    
    <div class="text-center mb-10 md:mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">
        {t("services.pageTitle")}
      </h2>
      <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto">
        {t("services.pageSubtitle")}
      </p>
    </div>
  
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
      
      <!-- Asbestos Abatement -->
      <a 
        href={`${basePath}/asbestos-abatement`}
        class="group flex flex-col items-center no-underline"
      >
        <div class="relative w-40 h-40 md:w-44 md:h-44 rounded-full overflow-hidden shadow-xl ring-4 ring-blue-100 group-hover:ring-blue-400 transition-all duration-300 ">
          <Image 
            src={AsbestosImg} 
            alt="Protective worker performing asbestos abatement service"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0  group-hover:to-blue-900/40 transition-all duration-300"></div>
        </div>
        
        <h3 class="mt-5 text-center text-gray-900 font-bold text-base md:text-lg group-hover:text-blue-600 transition-colors duration-200">
          {t("services.asbestos.title")}
        </h3>
        
        <p class="text-sm text-gray-600 text-center mt-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
          {t("services.asbestos.subtitle")}
        </p>
        
        <div class="flex items-center text-blue-600 text-sm font-medium mt-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 group-hover:translate-y-1 transition-all duration-300">
          Learn More
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

      <!-- Mold Remediation -->
      <a 
        href={`${basePath}/mold-remediation`}
        class="group flex flex-col items-center no-underline"
      >
        <div class="relative w-40 h-40 md:w-44 md:h-44 rounded-full overflow-hidden shadow-xl ring-4 ring-green-100 group-hover:ring-green-400 transition-all duration-300">
          <Image 
            src={MoldImg} 
            alt="Professional cleaning mold from residential wall"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0  group-hover:to-green-900/40 transition-all duration-300"></div>
        </div>
        
        <h3 class="mt-5 text-center text-gray-900 font-bold text-base md:text-lg group-hover:text-green-600 transition-colors duration-200">
          {t("services.mold.title")}
        </h3>
        
        <p class="text-sm text-gray-600 text-center mt-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
          {t("services.mold.subtitle")}
        </p>
        
        <div class="flex items-center text-green-600 text-sm font-medium mt-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 group-hover:translate-y-1 transition-all duration-300">
          Learn More
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

      <!-- Lead Abatement -->
      <a 
        href={`${basePath}/lead-abatement`}
        class="group flex flex-col items-center no-underline"
      >
        <div class="relative w-40 h-40 md:w-44 md:h-44 rounded-full overflow-hidden shadow-xl ring-4 ring-red-100 group-hover:ring-red-400 transition-all duration-300">
          <Image 
            src={LeadImg} 
            alt="Technician conducting lead paint removal in an old building"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0  group-hover:to-red-900/40 transition-all duration-300"></div>
        </div>
        
        <h3 class="mt-5 text-center text-gray-900 font-bold text-base md:text-lg group-hover:text-red-600 transition-colors duration-200">
          {t("services.lead.title")}
        </h3>
        
        <p class="text-sm text-gray-600 text-center mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          {t("services.lead.subtitle")}
        </p>
        
        <div class="flex items-center text-red-600 text-sm font-medium mt-2 opacity-0 group-hover:opacity-100 group-hover:translate-y-1 transition-all duration-300">
          Learn More
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

      <!-- Cleaning Services -->
      <a 
        href={`${basePath}/cleaning-services`}
        class="group flex flex-col items-center no-underline"
      >
        <div class="relative w-40 h-40 md:w-44 md:h-44 rounded-full overflow-hidden shadow-xl ring-4 ring-yellow-100 md:group-hover:ring-yellow-400 transition-all duration-300">
          <Image 
            src={CleaningImg} 
            alt="Residential or commercial space being cleaned by a janitorial crew"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0 group-hover:to-yellow-900/40 transition-all duration-300"></div>
        </div>
        
        <h3 class="mt-5 text-center text-gray-900 font-bold text-base md:text-lg group-hover:text-yellow-600 transition-colors duration-200">
          {t("services.cleaning.title")}
        </h3>
        
        <p class="text-sm text-gray-600 text-center mt-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
          {t("services.cleaning.subtitle")}
        </p>
        
        <div class="flex items-center text-yellow-600 text-sm font-medium mt-2 opacity-100 md:opacity-0 md:group-hover:opacity-100 group-hover:translate-y-1 transition-all duration-300">
          Learn More
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

    </div>
  </div>
</section>

