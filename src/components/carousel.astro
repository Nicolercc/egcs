---
import { Image } from 'astro:assets';

const imageData = [
  { path: import('../assets/IMG_1647.jpg'), description: "Wall plaster removal" },
  { path: import('../assets/IMG_2453.jpg'), description: "Mold removal" },
  { path: import('../assets/IMG_2458.jpg'), description: "Confined Space" },
  { path: import('../assets/IMG_2470.jpg'), description: "Concentration of asbestos" },
  { path: import('../assets/IMG_3367.jpg'), description: "Pipe asbestos removal" },
  { path: import('../assets/IMG_3378.jpg'), description: "Pipe asbestos removal" },
  { path: import('../assets/IMG_3394.jpg'), description: "Pipe asbestos removal" },
  { path: import('../assets/IMG_3397.jpg'), description: "Tile mastic removal" },
  { path: import('../assets/IMG_3407.jpg'), description: "Wall plaster removal" },
  { path: import('../assets/IMG_5100.jpg'), description: "Floor mastic removal" },
  { path: import('../assets/IMG_5782.jpg'), description: "VAT & mastic removal" },
  { path: import('../assets/IMG_5834.jpg'), description: "mastic removal" },
  { path: import('../assets/IMG_9226.jpg'), description: "Pipe removal" },
  { path: import('../assets/IMG_9254.jpg'), description: "Pipe removal" },
  { path: import('../assets/IMG_9256.jpg'), description: "Pipe removal" },
  { path: import('../assets/img000.jpg'), description: "Mold removal" },
  { path: import('../assets/IMG_9184.jpg'), description: "Pipe asbestos removal" },
  { path: import('../assets/IMG_3602.jpg'), description: "Lead removal" },
  { path: import('../assets/IMG_3603.jpg'), description: "Lead removal" },
  { path: import('../assets/IMG_3586.jpg'), description: "Lead removal" },
  { path: import('../assets/IMG_3482.jpg'), description: "Lead paint removal" },
  { path: import('../assets/IMG_2389.jpg'), description: "Mold detection" },
  { path: import('../assets/IMG_2611.jpg'), description: "Roof asbestos removal" },
  { path: import('../assets/IMG_2599.jpg'), description: "Roof asbestos removal" },
];

const images = await Promise.all(
  imageData.map(async (item, index) => ({
    image: (await item.path).default,
    description: item.description,
    loading: index === 0 ? 'eager' : 'lazy' as 'eager' | 'lazy',
    fetchpriority: index === 0 ? 'high' : 'auto' as 'high' | 'auto'
  }))
);
---

<div 
    id="indicators-carousel" 
    class="relative w-full mt-4 mb-2 md:my-0 group/carousel" 
    data-carousel="static"
    role="region"
    aria-label="Image carousel"
>
    <!-- Carousel wrapper -->
    <div class="relative h-56 overflow-hidden rounded-lg md:h-[300px] bg-gray-100">
        {images.map((item, index) => (
            <div 
                class={"absolute block w-full h-full transition-opacity duration-700 ease-in-out " + (index === 0 ? "opacity-100 z-10" : "opacity-0 z-0")} 
                data-carousel-item
                data-index={index}
                role="group"
                aria-roledescription="slide"
                aria-label={`Slide ${index + 1} of ${images.length}`}
            >
                <Image 
                    src={item.image} 
                    alt={item.description || `Slide ${index + 1}`} 
                    class="absolute w-full h-auto top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 object-cover" 
                    loading={item.loading}
                    fetchpriority={item.fetchpriority}
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 768px) 100vw, 1200px"
                />
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 via-black/50 to-transparent text-white p-3 md:p-4 pb-10 md:pb-12 text-center">
                    <p class="text-sm md:text-base font-medium">{item.description}</p>
                </div>
            </div>
        ))}
    </div>
    
    <!-- Slide indicators: rendered by JS into this container -->
    <div
        id="carousel-indicators"
        class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center space-x-1.5"
        role="tablist"
        aria-label="Slide indicators"
    ></div>
    
    <!-- Slider controls -->
    <button 
        type="button" 
        class="absolute top-1/2 -translate-y-1/2 start-3 z-30 flex items-center justify-center w-10 h-10 md:w-11 md:h-11 rounded-full bg-yellow-500/95 backdrop-blur-sm group transition-all duration-300 ease-out hover:bg-yellow-600 hover:scale-110 active:scale-95 focus:outline-none focus:ring-4 focus:ring-yellow-500/40 focus:ring-offset-2 shadow-xl hover:shadow-2xl opacity-0 group-hover/carousel:opacity-100 md:opacity-100" 
        data-carousel-prev
        aria-label="Previous slide"
    >
        <svg class="w-5 h-5 text-gray-900 rtl:rotate-180 transition-transform duration-300 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
        <span class="sr-only">Previous slide</span>
    </button>
    <button 
        type="button" 
        class="absolute top-1/2 -translate-y-1/2 end-3 z-30 flex items-center justify-center w-10 h-10 md:w-11 md:h-11 rounded-full bg-yellow-500/95 backdrop-blur-sm group transition-all duration-300 ease-out hover:bg-yellow-600 hover:scale-110 active:scale-95 focus:outline-none focus:ring-4 focus:ring-yellow-500/40 focus:ring-offset-2 shadow-xl hover:shadow-2xl opacity-0 group-hover/carousel:opacity-100 md:opacity-100" 
        data-carousel-next
        aria-label="Next slide"
    >
        <svg class="w-5 h-5 text-gray-900 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="sr-only">Next slide</span>
    </button>

    <div class="sr-only" aria-live="polite" aria-atomic="true" id="carousel-announcement"></div>
</div>

<style>
    @media (prefers-reduced-motion: reduce) {
        #indicators-carousel [data-carousel-item] {
            transition: none !important;
        }
        #indicators-carousel button {
            transition: background-color 0.2s ease !important;
        }
    }

    #indicators-carousel [data-carousel-item] {
        will-change: opacity;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    /* Dot size transitions */
    #carousel-indicators button {
        transition: width 0.3s ease, height 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
        flex-shrink: 0;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const carousel = document.getElementById('indicators-carousel');
        if (!carousel) return;

        const items = carousel.querySelectorAll('[data-carousel-item]');
        const indicatorContainer = document.getElementById('carousel-indicators');
        const announcement = document.getElementById('carousel-announcement');
        const TOTAL = items.length;
        const WINDOW_SIZE = 5; // dots visible at once
        let currentIndex = 0;
        let autoPlayInterval: ReturnType<typeof setInterval> | null = null;
        let isPaused = false;
        let touchStartX = 0;
        let touchEndX = 0;
        const AUTO_PLAY_DELAY = 5000;
        const SWIPE_THRESHOLD = 50;

        // ── Dot rendering ──────────────────────────────────────────────
        function getDotSize(distFromActive: number): { w: string; h: string; opacity: string } {
            // active=0 → large yellow; ±1 → medium; ±2 → small; beyond → hidden
            if (distFromActive === 0) return { w: '24px', h: '8px',  opacity: '1' };
            if (Math.abs(distFromActive) === 1) return { w: '8px',  h: '8px',  opacity: '1' };
            if (Math.abs(distFromActive) === 2) return { w: '6px',  h: '6px',  opacity: '0.5' };
            return { w: '0px', h: '0px', opacity: '0' };
        }

        function renderDots(activeIndex: number): void {
            if (!indicatorContainer) return;
            indicatorContainer.innerHTML = '';

            // Calculate window start so active dot is centred
            let windowStart = activeIndex - Math.floor(WINDOW_SIZE / 2);
            windowStart = Math.max(0, Math.min(windowStart, TOTAL - WINDOW_SIZE));

            for (let i = windowStart; i < windowStart + WINDOW_SIZE; i++) {
                if (i >= TOTAL) break;
                const dist = i - activeIndex;
                const size = getDotSize(dist);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.setAttribute('aria-label', `Go to slide ${i + 1}`);
                btn.setAttribute('aria-selected', i === activeIndex ? 'true' : 'false');
                btn.setAttribute('role', 'tab');
                btn.setAttribute('tabindex', i === activeIndex ? '0' : '-1');
                btn.style.width = size.w;
                btn.style.height = size.h;
                btn.style.opacity = size.opacity;
                btn.style.borderRadius = '9999px';
                btn.style.backgroundColor = i === activeIndex ? 'rgb(234 179 8)' : 'rgba(255,255,255,0.5)';
                btn.style.border = 'none';
                btn.style.cursor = 'pointer';
                btn.style.padding = '0';

                const capturedIndex = i;
                btn.addEventListener('click', () => {
                    goToSlide(capturedIndex);
                    pauseAutoPlay();
                    setTimeout(resumeAutoPlay, AUTO_PLAY_DELAY * 2);
                });

                indicatorContainer.appendChild(btn);
            }
        }

        // ── Slide logic ────────────────────────────────────────────────
        function preloadNextImage(index: number): void {
            const nextIndex = (index + 1) % TOTAL;
            const nextItem = items[nextIndex] as HTMLElement;
            const nextImage = nextItem?.querySelector('img');
            if (nextImage && !nextImage.complete) {
                const link = document.createElement('link');
                link.rel = 'preload';
                link.as = 'image';
                link.href = nextImage.src;
                document.head.appendChild(link);
            }
        }

        function announceSlide(index: number): void {
            if (announcement) {
                const slide = items[index] as HTMLElement;
                const label = slide.getAttribute('aria-label') || `Slide ${index + 1} of ${TOTAL}`;
                announcement.textContent = label;
            }
        }

        function showSlide(index: number): void {
            if (index < 0 || index >= TOTAL) return;
            currentIndex = index;

            items.forEach((item, i) => {
                const el = item as HTMLElement;
                if (i === index) {
                    el.classList.remove('opacity-0', 'z-0');
                    el.classList.add('opacity-100', 'z-10');
                    el.setAttribute('aria-hidden', 'false');
                } else {
                    el.classList.remove('opacity-100', 'z-10');
                    el.classList.add('opacity-0', 'z-0');
                    el.setAttribute('aria-hidden', 'true');
                }
            });

            renderDots(index);
            announceSlide(index);
            preloadNextImage(index);
        }

        function nextSlide(): void { showSlide((currentIndex + 1) % TOTAL); }
        function previousSlide(): void { showSlide((currentIndex - 1 + TOTAL) % TOTAL); }
        function goToSlide(index: number): void { showSlide(index); }

        function startAutoPlay(): void {
            if (autoPlayInterval) return;
            autoPlayInterval = setInterval(() => {
                if (!isPaused && !document.hidden) nextSlide();
            }, AUTO_PLAY_DELAY);
        }

        function stopAutoPlay(): void {
            if (autoPlayInterval) { clearInterval(autoPlayInterval); autoPlayInterval = null; }
        }

        function pauseAutoPlay(): void { isPaused = true; }
        function resumeAutoPlay(): void { isPaused = false; }

        // ── Controls ───────────────────────────────────────────────────
        const nextButton = carousel.querySelector('[data-carousel-next]') as HTMLButtonElement;
        const prevButton = carousel.querySelector('[data-carousel-prev]') as HTMLButtonElement;

        nextButton?.addEventListener('click', () => {
            nextSlide(); pauseAutoPlay(); setTimeout(resumeAutoPlay, AUTO_PLAY_DELAY * 2);
        });
        prevButton?.addEventListener('click', () => {
            previousSlide(); pauseAutoPlay(); setTimeout(resumeAutoPlay, AUTO_PLAY_DELAY * 2);
        });

        carousel.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'ArrowLeft')  { e.preventDefault(); previousSlide(); pauseAutoPlay(); setTimeout(resumeAutoPlay, AUTO_PLAY_DELAY * 2); }
            if (e.key === 'ArrowRight') { e.preventDefault(); nextSlide();     pauseAutoPlay(); setTimeout(resumeAutoPlay, AUTO_PLAY_DELAY * 2); }
            if (e.key === 'Home')       { e.preventDefault(); goToSlide(0); }
            if (e.key === 'End')        { e.preventDefault(); goToSlide(TOTAL - 1); }
        });

        carousel.addEventListener('touchstart', (e: TouchEvent) => {
            touchStartX = e.changedTouches[0].screenX; pauseAutoPlay();
        }, { passive: true });
        carousel.addEventListener('touchend', (e: TouchEvent) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > SWIPE_THRESHOLD) diff > 0 ? nextSlide() : previousSlide();
            setTimeout(resumeAutoPlay, AUTO_PLAY_DELAY * 2);
        }, { passive: true });

        carousel.addEventListener('mouseenter', pauseAutoPlay);
        carousel.addEventListener('mouseleave', resumeAutoPlay);
        carousel.addEventListener('focusin', pauseAutoPlay);
        carousel.addEventListener('focusout', resumeAutoPlay);

        document.addEventListener('visibilitychange', () => {
            document.hidden ? pauseAutoPlay() : resumeAutoPlay();
        });

        // ── Init ───────────────────────────────────────────────────────
        showSlide(0);
        startAutoPlay();

        window.addEventListener('beforeunload', stopAutoPlay);
    });
</script>