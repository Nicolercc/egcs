---
import Footer from "../components/footer.astro";
import Navbar from "../components/Navbar.astro";
import { getLangFromUrl, useTranslations } from "../i18n/translations";

interface Props {
  title?: string;
  lang?: "en" | "es";
}

const { title = "Elite Global Cleaning Services | Asbestos, Mold, Lead Removal & Cleaning in NYC", lang = getLangFromUrl(Astro.url) } = Astro.props;

const pathname = Astro.url.pathname;
const origin = Astro.url.origin;
const pathEn = pathname.startsWith("/es") ? (pathname.slice(3) || "/") : pathname;
const pathEs = pathname.startsWith("/es") ? pathname : pathname === "/" ? "/es" : "/es" + pathname;
const englishUrl = origin + pathEn;
const spanishUrl = origin + pathEs;
---

<html lang={lang}>
  <head>
    <link rel="preload" as="image" href="/_astro/hero.CZAvY9WT_L8RQA.webp" type="image/webp" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content="Elite Global Cleaning Services offers asbestos abatement, mold remediation, lead abatement, and residential/commercial cleaning throughout the Tristate area." />
    <meta name="keywords" content="asbestos abatement, mold remediation, lead removal, cleaning services, environmental services, NYC, Tri-state area, EGCS" />
    <meta name="author" content="Elite Global Cleaning Services" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Elite Global Cleaning Services" />
    <meta property="og:description" content="We provide top-tier environmental cleaning services across NYC and the Tri-state area, specializing in asbestos, mold, and lead abatement." />
    <meta property="og:image" content="/social-preview.jpg" />
    <meta property="og:url" content="https://www.eliteglobalcleaning.com" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Elite Global Cleaning Services" />
    <meta name="twitter:description" content="Your trusted experts in mold, asbestos, and lead abatement in the Tri-state area." />
    <meta name="twitter:image" content="/social-preview.jpg" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.eliteglobalcleaning.com" />

    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />

  
  </head>
  <body>
  
    <Navbar />

    <main class="">
      <slot />
    </main>

    <footer>
      <Footer />
    </footer>
    
   
  </body>
</html>
