---
import Footer from "../components/footer.astro";
import Navbar from "../components/Navbar.astro";
import { getLangFromUrl } from "../i18n/translations";

const { title = "Elite Global Cleaning Services | Asbestos, Mold, Lead Removal & Cleaning in NYC" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;
const pathEn = pathname.replace(/^\/es/, '') || '/';
const pathEs = pathname.startsWith('/es') ? pathname : '/es' + pathname;
const baseUrl = "https://www.eliteglobalcleaning.com";
const canonicalUrl = baseUrl + (lang === 'es' ? pathEs : pathEn);
---

<html lang={lang}>
  <head>
    <link rel="preload" as="image" href="/_astro/hero.CZAvY9WT_L8RQA.webp" type="image/webp" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content="Elite Global Cleaning Services offers asbestos abatement, mold remediation, lead abatement, and residential/commercial cleaning throughout the Tristate area." />
    <meta name="keywords" content="asbestos abatement, mold remediation, lead removal, cleaning services, environmental services, NYC, Tri-state area, EGCS" />
    <meta name="author" content="Elite Global Cleaning Services" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Elite Global Cleaning Services" />
    <meta property="og:description" content="We provide top-tier environmental cleaning services across NYC and the Tri-state area, specializing in asbestos, mold, and lead abatement." />
    <meta property="og:image" content="/social-preview.jpg" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Elite Global Cleaning Services" />
    <meta name="twitter:description" content="Your trusted experts in mold, asbestos, and lead abatement in the Tri-state area." />
    <meta name="twitter:image" content="/social-preview.jpg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Alternate language versions (hreflang) -->
    <link rel="alternate" hreflang="en" href={`${baseUrl}${pathEn}`} />
    <link rel="alternate" hreflang="es" href={`${baseUrl}${pathEs}`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}${pathEn}`} />

    <style is:global>
      /* Prevent FOUC (Flash of Untranslated Content) */
      .goog-te-spinner-pos {
        z-index: 1000;
      }
    </style>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Elite Global Cleaning Services",
    "image": "https://www.eliteglobalcleaning.com/social-preview.jpg",
    "url": "https://www.eliteglobalcleaning.com",
    "telephone": ["+1-929-888-3848", "+1-929-784-8804"],
    "email": "eliteglobalcs1.llc@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "New York",
      "addressRegion": "NY",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 40.7128,
      "longitude": -74.006
    },
    "openingHours": "Mo-Su 00:00-23:59",
    "description": "Certified asbestos abatement, mold remediation, lead abatement, and professional cleaning services for homes, schools, and businesses in the NYC Tri-state area.",
    "sameAs": [
      "https://www.facebook.com/eliteglobalcs",
      "https://www.instagram.com/eliteglobalcs"
    ]
  }
  </script>
  
  </head>
  <body>
  
    <Navbar />

    <main class="">
      <slot />
    </main>

    <footer>
      <Footer lang={lang} />
    </footer>
    
   
  </body>
</html>
