---
// Importing required components, assets, and services
import BaseLayout from '../../layouts/baselayout.astro';
import CleaningServicesImg from '../../assets/cleaning.jpg';
import AsbestosAbatementImg from '../../assets/Asbestos-abatement.jpg';
import LeadAbatementImg from '../../assets/lead-paint-removal.jpg';
import MoldRemediationImg from '../../assets/mold.jpg';
import { Image } from 'astro:assets';

import { getLangFromUrl, useTranslations } from "../../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const basePath = lang === "es" ? "/es/services" : "/services";

// Licenses data
const licenses = [
  "Asbestos Abatement Contractor License",
  "Lead Abatement Contractor License",
  "Mold Remediation Contractor License",
  "HAZWOPER Certification",
  "OSHA Bloodborne Pathogen Certification",
  "Healthcare Construction & Infection Control Certificate",
];

// Contact information
const contactInfo = {
  name: "Elite Global Cleaning Services",
  address: "New York, New York",
  phones: [
    "(929) 888-3848",
    "(929) 784-8804", 
    "(929) 354-4114"
  ],
  email: "eliteglobalcs1.llc@gmail.com",
};
---

<BaseLayout title="Our Services - Elite Global Cleaning Services">
    <!-- Services Section -->
    <div class="bg-gray-100">
      <section class="py-16">
        <div class="pt-14">
          <h1 class="text-4xl font-bold text-center text-gray-800">
            {t("services.pageTitle")}
          </h1>

          <p class="text-center text-gray-600 mb-12">
            {t("services.pageSubtitle")}
          </p>
        </div>
        <hr class="border-t-2 border-gray-300 mb-12" />
        <div class="container mx-auto px-6">
          <!-- Services Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Cleaning Services Card -->
            <div class="bg-white border rounded-lg p-6 shadow-sm transform transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-lg hover:border-orange-500">
              <a href={`${basePath}/cleaning-services`}>
                <div class="flex items-center mb-4">
                  <!-- Icon -->
                  <div class="bg-orange-100 rounded-full p-2 flex items-center justify-center">
                    <svg
                      class="w-6 h-6 text-orange-500"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4l3 3m4-2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  </div>
                  <h2 class="ml-3 text-2xl font-bold text-gray-800">{t("services.cleaning.title")}</h2>
                </div>
                <p class="text-gray-600 mb-4">
                  {t("services.cleaning.subtitle")}
                </p>
                <div class="h-40 bg-gray-100 rounded-lg flex items-center justify-center">
                  <Image src={CleaningServicesImg} alt="Asbestos Abatement" class="w-full h-full object-cover rounded-lg"/>
                </div>
                <p class="text-gray-600 mt-4">
                  {t("services.cleaning.body")}
                </p>
              </a>
            </div>

            <!-- Asbestos Abatement Card -->
            <div class="bg-white border rounded-lg p-6 shadow-sm transform transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-lg hover:border-blue-500">
              <a href={`${basePath}/asbestos-abatement`}>
                <div class="flex items-center mb-4">
                  <!-- Icon -->
                  <div class="bg-blue-100 rounded-full p-2 flex items-center justify-center">
                    <svg
                      class="w-6 h-6 text-blue-500"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  </div>
                  <h2 class="ml-3 text-2xl font-bold text-gray-800">{t("services.asbestos.title")}</h2>
                </div>
                <p class="text-gray-600 mb-4">
                  {t("services.asbestos.subtitle")}
                </p>
                <div class="h-40 bg-gray-100 rounded-lg flex items-center justify-center">
                  <Image src={AsbestosAbatementImg} alt="Asbestos Abatement" class="w-full h-full object-cover rounded-lg"/>
                </div>
                <p class="text-gray-600 mt-4">
                  {t("services.asbestos.body")}
                </p>
              </a>
            </div>

            <!-- Lead Abatement Card -->
            <div class="bg-white border rounded-lg p-6 shadow-sm transform transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-lg hover:border-red-500">
           <a href={`${basePath}/lead-abatement`}>
                <div class="flex items-center mb-4">
                  <!-- Icon -->
                  <div class="bg-red-100 rounded-full p-2 flex items-center justify-center">
                    <svg
                      class="w-6 h-6 text-red-500"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 2a10 10 0 00-4 19.396V22h8v-1.604A10 10 0 0012 2z"
                      />
                    </svg>
                  </div>
                  <h2 class="ml-3 text-2xl font-bold text-gray-800">{t("services.lead.title")}</h2>
                </div>
                <p class="text-gray-600 mb-4">
                  {t("services.lead.subtitle")}
                </p>
                <div class="h-40 bg-gray-100 rounded-lg flex items-center justify-center">
                  <Image src={LeadAbatementImg} alt="Asbestos Abatement" class="w-full h-full object-cover rounded-lg"/>
                </div>
                <p class="text-gray-600 mt-4">
                  {t("services.lead.body")}
                </p>
              </a>
            </div>

            <!-- Mold Remediation Card -->
            <div class="bg-white border rounded-lg p-6 shadow-sm transform transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-lg hover:border-green-500">
              <a href={`${basePath}/mold-remediation`}>
                <div class="flex items-center mb-4">
                  <!-- Icon -->
                  <div class="bg-green-100 rounded-full p-2 flex items-center justify-center">
                    <svg
                      class="w-6 h-6 text-green-500"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 22s-8-4-8-10a8 8 0 1116 0c0 6-8 10-8 10z"
                      />
                    </svg>
                  </div>
                  <h2 class="ml-3 text-2xl font-bold text-gray-800">{t("services.mold.title")}</h2>
                </div>
                <p class="text-gray-600 mb-4">
                  {t("services.mold.subtitle")}
                </p>
                <div class="h-40 bg-gray-100 rounded-lg flex items-center justify-center">
                  <Image src={MoldRemediationImg} alt="Asbestos Abatement" class="w-full h-full object-cover rounded-lg"/>
                </div>
                <p class="text-gray-600 mt-4">
                  {t("services.mold.body")}
                </p>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
</BaseLayout>

