---
import BaseLayout from '../layouts/baselayout.astro'
import ContactSection from '../components/ContactSection.astro';
import CleaningImg from '../assets/cleaning.jpg'
import AsbestosImg from '../assets/Asbestos-abatement.jpg'
import MoldImg from '../assets/mold.jpg'
import LeadImg from '../assets/lead-paint-removal.jpg'
import hero from '../assets/hero.jpeg'
import Carousel from "@components/carousel.astro";
import { Image } from "astro:assets";

const services = [
 
{ 
  title: 'Asbestos Abatement', 
  img: AsbestosImg, 
  alt: 'Protective worker performing asbestos abatement service', 
  link: '/services/asbestos-abatement' 
},
{ 
  title: 'Mold Remediation', 
  img: MoldImg, 
  alt: 'Professional cleaning mold from residential wall', 
  link: '/services/mold-remediation'  
},
{ 
  title: 'Lead Abatement', 
  img: LeadImg, 
  alt: 'Technician conducting lead paint removal in an old building', 
  link: '/services/lead-abatement' 
},
{ 
  title: 'Cleaning Services', 
  img: CleaningImg, 
  alt: 'Residential or commercial space being cleaned by a janitorial crew', 
  link: '/services/cleaning-services' 
},

 
];
---


	<BaseLayout title="Elite Global Cleaning Services">
		<section class="relative h-screen flex items-center justify-center text-center text-white">
			<div class="absolute inset-0 z-10 bg-black/50"></div>
			
			<div class="absolute inset-0 w-full h-full">
				<Image 
					src={hero} 
					alt="Workers performing professional asbestos, mold removal, lead abatement, and cleaning services in NYC home"
					class="w-full h-full object-cover"
				/>
			</div>
			
			<div class="relative z-10 max-w-3xl mx-auto px-4">
				<!-- <h2 class="text-4xl font-bold mb-4 text-gray-300">Welcome to </h2> -->
				<h1 class="text-3xl md:text-5xl font-bold m-6 text-gray-200">Elite Global Cleaning Services</h1>
				<p class="text-xl mb-8 text-gray-300">Certified asbestos, lead, and mold removal plus professional cleaning—serving the New York Tri-State Area with trusted, safe, and compliant environmental services.</p>
				
				<div class="text-center mt-4">
					<a class="inline-block bg-yellow-600 rounded-2xl hover:bg-yellow-700 text-white px-6 py-3  transition duration-300" href="/quote">Contact Us</a>
				</div>
			</div>
		</section>
		

		
		<div class="md:py-14 py-10 px-8 md:px-16 lg:px-32">
			<div class="flex flex-col md:flex-row ">
		
				<div class="w-full">
					<h2 class="text-3xl md:text-4xl font-bold mb-7 md:mb-10  text-center ">EGCS is Family Owned &amp; Operated</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8 pb-10">
						<div class="flex items-center">
							<p class="text-lg text-gray-700 md:pr-6 md:py-4">
								We offer <b>immediate solutions</b>. We have specialized, certified, and highly experienced personnel to carry out the work. 
								If you are concerned about whether your property, home, or workplace may be contaminated with <b>mold, lead, or asbestos</b>, 
								or if you need a continuous <b>cleaning system</b>. We are here for you; <b>call us</b> and we can help you immediately. It doesn't matter if it's a small 
								or large damage, because <b>our clients are important to us</b>.
							</p>
						</div>
						<div class="flex items-center">
							<Carousel />
						</div>
					</div>
					
					
				</div>
				
			</div>
		
	
			<section class=" px-4 md:py-18">
				<div class="max-w-6xl mx-auto">
				  <h2 class="text-3xl font-bold text-center mb-10 text-gray-800">
					Services Provided
				  </h2>
				
				  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-12">
					{
					  services.map((service) => (
						<a 
						  href={service.link}
						  class="flex flex-col items-center group no-underline "
						>
						  {/* Image Container */}
						  <div class="relative w-40 h-40 rounded-full overflow-hidden shadow-2xl">
							<Image 
							  src={service.img} 
							  alt={service.alt} 
							  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 "
							/>
							<div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300"></div>
						  </div>
						  {/* Title */}
						  <div class="mt-4 text-center text-gray-800 font-bold text-sm sm:text-base group-hover:underline">
							{service.title.toUpperCase()}
						  </div>
						</a>
					  ))
					}
				  </div>
				  
				</div>
			  </section>
			  
		<section class="bg-gray-50 p-0 m-0">

			<ContactSection
			title="Contact Our Team" 
			aria-label="Request a quote for asbestos, mold, or lead abatement"
			email="eliteglobalcs1.llc@gmail.com" 
		/>
		</section>
					

	</BaseLayout>

